# Development settings. No credentials are needed for the local database.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/qarhub.sqlite
# Exact comma-separated browser origins allowed to change data.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001
# Enable only behind HTTPS; automatically required in production.
COOKIE_SECURE=false
# For local-network development, set DEV_HOST=0.0.0.0 and add your LAN URL
# (e.g. http://192.168.1.10:5173) to APP_ORIGINS. Do not expose the dev server publicly.
DEV_HOST=127.0.0.1
